# ⚠️ 이 파일은 부트스트랩 시점에 EC2에 그대로 생성되는 placeholder입니다.
# 실제 운영 값은 Terraform 코드/state에 절대 넣지 말고, 배포 후 서버에서 직접
# (SSH 또는 SSM exec) 값을 채워 넣으세요. MYSQL_ROOT_PASSWORD/MYSQL_PASSWORD가
# 비어 있으면 mysql 컨테이너 자체가 기동되지 않고, 그 결과 app 컨테이너도 DB
# 연결에 실패합니다 (Redis 스택만은 이 파일과 무관하게 정상 기동됩니다).

# ── Spring ──
# application.yaml 기본값이 active: dev라서 명시하지 않으면 dev+secret으로 뜸.
# secret은 application.yaml의 spring.profiles.include로 항상 자동 병합되므로 prod만 지정.
SPRING_PROFILES_ACTIVE=prod

# ── Docker Compose ──
IMAGE_TAG=latest

# ── MySQL (같은 EC2 안 mysql 컨테이너, redis-net 내부 네트워크로만 접근 — 무료/무과금) ──
# MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD는 반드시 채워야 mysql 컨테이너가 기동됨
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=service_db
MYSQL_USER=app
MYSQL_PASSWORD=
DB_URL=jdbc:mysql://mysql:3306/service_db
DB_USERNAME=app
DB_PASSWORD=   # MYSQL_PASSWORD와 동일한 값이어야 함

# ── Redis Sentinel (redis-net 도커 네트워크 내부 호스트명 기준) ──
REDIS_SENTINEL_MASTER=mymaster
REDIS_SENTINEL_1=redis-sentinel-1:26379
REDIS_SENTINEL_2=redis-sentinel-2:26379
REDIS_SENTINEL_3=redis-sentinel-3:26379
REDIS_PASSWORD=

# ── OAuth2 (application-secret.yaml의 secret 프로필이 우선 적용될 수 있음) ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── JWT / 암호화 (application-secret.yaml의 secret 프로필이 우선 적용될 수 있음) ──
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://nbe-10-12-2-team02-fv1h.vercel.app
