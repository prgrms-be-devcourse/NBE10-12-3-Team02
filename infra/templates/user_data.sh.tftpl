
#!/bin/bash
set -eux

# ── 스왑 4GB 생성 (t3.micro 메모리 부족 대비) ──
dd if=/dev/zero of=/swapfile bs=128M count=32
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo "/swapfile swap swap defaults 0 0" >> /etc/fstab

# ── 타임존 설정 ──
timedatectl set-timezone Asia/Seoul

# ── Docker 설치 (Amazon Linux 2023) ──
dnf update -y
dnf install -y docker
systemctl enable docker
systemctl start docker
usermod -aG docker ec2-user

# ── Docker Compose v2 플러그인 설치 ──
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# ── 앱 디렉터리 구성 ──
APP_DIR=/home/ec2-user/app
mkdir -p "$APP_DIR"

cat > "$APP_DIR/docker-compose.yaml" <<'COMPOSE_EOF'
${docker_compose_content}
COMPOSE_EOF

cat > "$APP_DIR/.env" <<'ENV_EOF'
${env_file_content}
ENV_EOF
chmod 600 "$APP_DIR/.env"
chown -R ec2-user:ec2-user "$APP_DIR"

cd "$APP_DIR"

# ── MySQL + Redis Sentinel 스택 기동 ──
# mysql은 .env의 MYSQL_ROOT_PASSWORD가 비어 있으면 컨테이너 자체가 재시작을 반복할 수 있음
# (docker compose up 명령 자체는 성공하며, 이후 .env를 채우고 재기동하면 정상화됨)
docker compose --env-file .env up -d mysql redis-primary redis-replica redis-sentinel-1 redis-sentinel-2 redis-sentinel-3

# app 컨테이너(app-blue/app-green)는 더 이상 docker compose가 관리하지 않음.
# 배포 스크립트가 docker run으로 blue/green을 직접 기동/전환하고, nginx가
# upstream.conf를 통해 현재 활성 컨테이너의 포트로 프록시한다.

# ── nginx 설치 + HTTPS 리버스 프록시 (sslip.io + Let's Encrypt) ──
dnf install -y nginx

# 이 인스턴스엔 Elastic IP가 없어 재생성될 때마다 퍼블릭 IP가 바뀔 수 있으므로,
# 도메인을 고정 문자열로 박지 않고 부팅 시점의 실제 퍼블릭 IP로 sslip.io 도메인을 매번 계산한다.
IMDS_TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
PUBLIC_IP=$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4)
DOMAIN="$${PUBLIC_IP//./-}.sslip.io"

# ── certbot 설치 (Amazon Linux 2023은 공식 certbot 패키지 미제공 -> pip venv, certbot 공식 권장 방식) ──
dnf install -y python3-pip augeas-libs
if [ ! -d /opt/certbot ]; then
  python3 -m venv /opt/certbot
fi
/opt/certbot/bin/pip install --upgrade pip
/opt/certbot/bin/pip install certbot certbot-nginx
ln -sf /opt/certbot/bin/certbot /usr/bin/certbot

# ── nginx 리버스 프록시 설정 (upstream.conf로 백엔드 대상 분리, blue/green 전환 대비) ──
cat > /etc/nginx/conf.d/upstream.conf <<'UPSTREAM_EOF'
upstream app_backend {
    server 127.0.0.1:8080;
}
UPSTREAM_EOF

cat > /etc/nginx/conf.d/app.conf <<NGINX_EOF
server {
    listen 80;
    server_name $DOMAIN;

    location / {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 86400;
    }
}
NGINX_EOF

nginx -t
systemctl enable --now nginx
systemctl reload nginx

# ── Let's Encrypt 인증서 발급 + nginx 443 블록 자동 구성 (certbot이 conf 파일을 직접 수정) ──
# DNS 전파 지연 등 일시적 사유로 실패해도 부트스트랩 전체를 막지 않도록 non-fatal 처리
certbot --nginx \
  -d "$DOMAIN" \
  --non-interactive --agree-tos \
  -m "${letsencrypt_email}" \
  --redirect \
  || echo "[bootstrap] Let's Encrypt 인증서 발급 실패 - 'certbot --nginx -d $DOMAIN --redirect' 수동 재실행 필요"

# ── 인증서 자동 갱신 (systemd timer; AL2023엔 기본 cron 데몬이 없어 timer로 등록) ──
cat > /etc/systemd/system/certbot-renew.service <<'SERVICE_EOF'
[Unit]
Description=Certbot renewal

[Service]
Type=oneshot
ExecStart=/opt/certbot/bin/certbot renew --quiet --deploy-hook "systemctl reload nginx"
SERVICE_EOF

cat > /etc/systemd/system/certbot-renew.timer <<'TIMER_EOF'
[Unit]
Description=Run certbot renewal twice daily

[Timer]
OnCalendar=*-*-* 03,15:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
TIMER_EOF

systemctl daemon-reload
systemctl enable --now certbot-renew.timer

nginx -t
systemctl is-active nginx
